# Mini project no.01 : Calculator
# Take input from the user
a=int(input("First Number: "))
b=int(input("Second Number: "))

# Perform arithmetic operaios
print("Add =", a+b)
print("Subtract =", a-b)
print("Multiply =", a*b)

# Prevent division by zero erro 
if b !=0:
    print("Divide =", a/b)
else :
    print("Divide = Cannot divide by zero")
